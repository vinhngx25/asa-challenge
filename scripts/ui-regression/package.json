{
  "name": "asa-ui-regression",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Optional real-browser UI regression for the ASA challenge (separate from the npm workspaces)",
  "scripts": {
    "setup": "playwright install chromium",
    "test": "node ui-run.mjs",
    "test:public": "node ui-public.mjs",
    "test:layout": "node ui-layout.mjs",
    "test:resilience": "node ui-resilience.mjs",
    "test:visual": "node ui-visual.mjs",
    "test:visual:update": "node ui-visual.mjs --update",
    "test:perf": "node ui-perf.mjs"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.10.0",
    "pixelmatch": "^8.0.0",
    "playwright": "^1.64.1",
    "pngjs": "^7.0.0"
  }
}
