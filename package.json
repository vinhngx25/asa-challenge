{
  "name": "asa-challenge",
  "version": "1.0.0",
  "private": true,
  "description": "Unified Service Scheduler: resource-constrained dealership appointment booking",
  "license": "MIT",
  "workspaces": [
    "shared",
    "backend",
    "frontend",
    "infra"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "db:up": "docker compose up -d dynamodb",
    "db:down": "docker compose down",
    "seed:local": "npm run seed:local -w backend",
    "seed:aws": "npm run seed:aws -w backend",
    "dev": "node scripts/dev.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run typecheck && npm run build -w frontend",
    "test": "npm run test -w backend",
    "test:integration": "npm run test:integration -w backend",
    "deploy": "npm run build && npm run deploy -w infra",
    "destroy": "npm run destroy -w infra"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}

