{
  "name": "@asa/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/local.ts",
    "start": "tsx src/local.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "seed:local": "tsx src/seed/run.ts",
    "seed:aws": "tsx src/seed/run.ts --aws"
  },
  "dependencies": {
    "@asa/shared": "^1.0.0",
    "@aws-lambda-powertools/logger": "^2.36.0",
    "@aws-lambda-powertools/metrics": "^2.36.0",
    "@aws-lambda-powertools/tracer": "^2.36.0",
    "@aws-sdk/client-dynamodb": "^3.1152.0",
    "@aws-sdk/client-secrets-manager": "^3.1152.0",
    "@aws-sdk/lib-dynamodb": "^3.1152.0",
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
